{% comment %}
  ProInspect Routine Inspection Booking Form
  Service-specific Shopify booking form for Routine Inspections.
{% endcomment %}

<div
  class="proinspect-booking proinspect-booking--routine-inspection"
  data-proinspect-booking
  data-api-base="{{ block.settings.api_base_url | escape }}"
  data-checkout-mode="{{ block.settings.checkout_mode | escape }}"
  data-default-service="Routine Inspection"
  data-locked-service="Routine Inspection"
  data-book-another-url="{{ block.settings.book_another_url | escape }}"
  data-service-map='{{ block.settings.service_variant_map | escape }}'
>
  <div class="proinspect-booking__header">
    <p class="proinspect-booking__eyebrow">{{ block.settings.eyebrow | escape }}</p>
    <h2>{{ block.settings.heading | escape }}</h2>
    <p>{{ block.settings.intro | escape }}</p>
  </div>

  <ol class="proinspect-booking__steps" aria-label="Booking steps" data-booking-steps>
    <li data-step-label="1" class="is-active">Property</li>
    <li data-step-label="2">Availability</li>
    <li data-step-label="3">Confirm</li>
  </ol>

  <form class="proinspect-booking__form" data-booking-form novalidate>
    <section class="proinspect-booking__panel is-active" data-step="1">
      <h3>Routine Inspection details</h3>
      <p class="proinspect-booking__muted">Enter the rental property address so we can check available routine inspection times.</p>

      <p class="proinspect-booking__locked-service" data-locked-service-label>
        Service: <strong data-locked-service-name>Routine Inspection</strong>
      </p>

      <label data-service-field hidden>
        Service type
        <select name="serviceType" required data-service-select>
          <option value="Routine Inspection" selected>Routine Inspection</option>
        </select>
      </label>

      <label>
        Property address
        <input name="propertyAddress" required autocomplete="street-address" placeholder="12 Example Street, Suburb WA 6000" data-address-input>
        <input type="hidden" name="placeId" data-place-id>
        <div class="proinspect-booking__address-suggestions" data-address-suggestions hidden></div>
      </label>

      <div class="proinspect-booking__actions">
        <button type="button" data-next-from-service>Find routine inspection times</button>
      </div>
    </section>

    <section class="proinspect-booking__panel" data-step="2">
      <h3>Choose a routine inspection time</h3>
      <p class="proinspect-booking__muted">Routine Inspection bookings are scheduled for 30 minutes, plus travel and buffer time.</p>

      <label class="proinspect-booking__date">
        Preferred date
        <input name="preferredDate" type="date" required data-preferred-date>
      </label>

      <div class="proinspect-booking__status" data-availability-status hidden></div>
      <div class="proinspect-booking__slots" data-slots></div>

      <input type="hidden" name="selectedSlotStart" data-selected-slot-start>
      <input type="hidden" name="selectedSlotEnd" data-selected-slot-end>
      <input type="hidden" name="selectedVariantId" data-selected-variant-id>
      <input type="hidden" name="loadingLabel" data-loading-label>
      <input type="hidden" name="loadingAmount" data-loading-amount>

      <div class="proinspect-booking__actions">
        <button type="button" class="proinspect-booking__secondary" data-back-to-service>Back</button>
        <button type="button" data-next-from-slots disabled>Continue</button>
      </div>
    </section>

    <section class="proinspect-booking__panel" data-step="3">
      <h3>Confirm Routine Inspection booking</h3>
      <div class="proinspect-booking__summary" data-summary></div>

      <div class="proinspect-booking__grid">
        <label>
          Customer name
          <input name="customerName" required autocomplete="name">
        </label>
        <label>
          Email
          <input name="customerEmail" type="email" required autocomplete="email">
        </label>
        <label>
          Phone
          <input name="customerPhone" required autocomplete="tel">
        </label>
        <label>
          Agency, if applicable
          <input name="agency">
        </label>
      </div>

      <label>
        Access details
        <textarea name="accessMethod" placeholder="Lockbox, keys, tenant contact, parking, pets, gate code or alarm details"></textarea>
      </label>

      <label>
        Additional notes
        <textarea name="notes" placeholder="Anything else the booking team needs to know for the routine inspection"></textarea>
      </label>

      <div class="proinspect-booking__actions">
        <button type="button" class="proinspect-booking__secondary" data-back-to-slots>Back</button>
        <button type="submit" data-confirm-booking>Confirm routine inspection booking</button>
      </div>
    </section>
  </form>

  <section class="proinspect-booking__confirmation" data-booking-complete hidden>
    <h3>Routine Inspection booking added</h3>
    <p data-booking-complete-message>Your booking request has been added.</p>
    <div class="proinspect-booking__actions">
      <button type="button" class="proinspect-booking__secondary" data-book-another-service>Book another service</button>
      <a class="proinspect-booking__button" href="/checkout" data-continue-checkout>Continue to checkout</a>
    </div>
  </section>

  <div class="proinspect-booking__status" data-booking-status hidden></div>
</div>

{{ 'proinspect-booking-calendar.css' | asset_url | stylesheet_tag }}
<script src="{{ 'proinspect-booking-calendar.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Routine booking form",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "ProInspect"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Book a Routine Inspection"
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Intro text",
      "default": "Schedule a 30-minute routine inspection for your rental property."
    },
    {
      "type": "url",
      "id": "api_base_url",
      "label": "Cloud Run API base URL",
      "default": "https://proinspect-booking-app-696236368989.australia-southeast1.run.app"
    },
    {
      "type": "select",
      "id": "checkout_mode",
      "label": "Checkout mode",
      "default": "cart",
      "options": [
        { "value": "cart", "label": "Add service to cart and let customer continue" },
        { "value": "none", "label": "Create booking only" }
      ]
    },
    {
      "type": "text",
      "id": "book_another_url",
      "label": "Book another service URL",
      "info": "Optional. Use a general booking page URL, for example /pages/book-an-inspection.",
      "default": ""
    },
    {
      "type": "textarea",
      "id": "service_variant_map",
      "label": "Service to Shopify variant map JSON",
      "info": "Maps service handles and loading labels to variant IDs. Example: {\"routine-inspection\":{\"Standard Hours\":\"52326025822490\"}}",
      "default": "{}"
    }
  ]
}
{% endschema %}
